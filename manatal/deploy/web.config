<?xml version="1.0" encoding="UTF-8"?>
<!-- ============================================================
     Manatal ETL - Reverse proxy IIS (ARR) para a app Spring Boot
     ------------------------------------------------------------
     PREREQUISITOS (1x na máquina):
       1) Instalar IIS + "URL Rewrite" + "Application Request Routing (ARR)".
       2) IIS > Application Request Routing Cache > Server Proxy Settings
          > marcar "Enable proxy" (aplicar).
       3) Site IIS (HTTPS externo) apontando para esta pasta web.config.
     A app roda em http://127.0.0.1:8080 e este arquivo faz o proxy
     de tudo para ela, preservando Host e protocolo externo.
     ============================================================ -->
<configuration>
  <system.webServer>

    <rewrite>
      <!-- Permite a regra abaixo gravar os headers de proxy -->
      <allowedServerVariables>
        <add name="HTTP_X_FORWARDED_HOST" />
        <add name="HTTP_X_FORWARDED_PROTO" />
      </allowedServerVariables>

      <rules>
        <rule name="ReverseProxyToManatal" stopProcessing="true">
          <match url="(.*)" />
          <!-- Se o acesso externo for http (sem SSL no IIS), troque https por http -->
          <action type="Rewrite" url="http://127.0.0.1:8080/{R:1}" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
        </rule>
      </rules>
    </rewrite>

    <!-- Corpo de requisição máximo em bytes (50 MB - folga para o batch) -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>

    <!-- Remove o header Server do IIS (bom para segurança) -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>
</configuration>
